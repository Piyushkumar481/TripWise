# Spring profile: dev for local development, prod for production
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL container configuration
POSTGRES_DB=tripwise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend database connection
DB_URL=jdbc:postgresql://postgres:5432/tripwise
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Authentication
# Replace this placeholder with a strong, randomly generated secret.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRATION=86400000

# Frontend origin allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Document storage
# Use local for development or azure when Azure is configured.
TRIPWISE_STORAGE_PROVIDER=local
TRIPWISE_DOCUMENT_STORAGE=./storage/documents

# Required when TRIPWISE_STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=tripwise-documents
